# PhishShield AI - Environment Configuration Example
# Copy to .env and customize for your deployment environment

ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated, or * for open)
# In production, restrict to your Chrome extension ID: chrome-extension://<EXTENSION_ID>
CORS_ORIGINS=*

# Security & SLA Limits
ANALYSIS_TIMEOUT_SECONDS=3.5
MAX_URL_REDIRECTS=5
SSRF_PROTECTION_ENABLED=true
